{
    "name": "@y-block/input",
    "version": "1.0.0",
    "type": "module",
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build:types": "tsc",
        "build:compile": "library src/**/*",
        "build:exports": "exports lib/**/* types/**/* --wrappers",
        "dev:exports": "exports src/**/* --watch",
        "build": "npm run build:types && npm run build:compile && npm run build:exports",
        "prepublishOnly": "npm run build",
        "dev": "vite dev  --open"
    },
    "devDependencies": {
        "@hocuspocus/provider": "^2.9.0",
        "yjs": "^13.6.26",
        "@atomico/vite": "^2.21.1",
        "vite": "^5.1.6",
        "atomico": "^1.79.1",
        "@y-block/store": "workspace:*"
    },
    "peerDependencies": {
        "@atomico/react": "*",
        "@atomico/vue": "*"
    },
    "peerDependenciesMeta": {
        "@atomico/react": {
            "optional": true
        },
        "@atomico/vue": {
            "optional": true
        }
    },
    "types": "types/index.d.ts",
    "typesVersions": {
        "*": {
            "y-input": [
                "types/y-input.d.ts"
            ],
            "y-input.stories": [
                "types/y-input.stories.d.ts"
            ],
            "y-input/react": [
                "wrapper/y-input/react.d.ts"
            ],
            "y-input/preact": [
                "wrapper/y-input/preact.d.ts"
            ],
            "y-input/vue": [
                "wrapper/y-input/vue.d.ts"
            ],
            "input": [
                "types/input.d.ts"
            ],
            "input/react": [
                "wrapper/input/react.d.ts"
            ],
            "input/preact": [
                "wrapper/input/preact.d.ts"
            ],
            "input/vue": [
                "wrapper/input/vue.d.ts"
            ]
        }
    },
    "exports": {
        "./index.CMWU6I-c": {
            "default": "./lib/entry/index.CMWU6I-c.js"
        },
        "./input.BJNM7e5_": {
            "default": "./lib/entry/input.BJNM7e5_.js"
        },
        "./README.md": {
            "default": "./types/README.md"
        },
        ".": {
            "types": "./types/index.d.ts",
            "default": "./lib/index.js"
        },
        "./input": {
            "types": "./types/input.d.ts",
            "default": "./lib/input.js"
        },
        "./input/react": {
            "types": "./wrapper/input/react.d.ts",
            "default": "./wrapper/input/react.js"
        },
        "./input/preact": {
            "types": "./wrapper/input/preact.d.ts",
            "default": "./wrapper/input/preact.js"
        },
        "./input/vue": {
            "types": "./wrapper/input/vue.d.ts",
            "default": "./wrapper/input/vue.js"
        }
    }
}
